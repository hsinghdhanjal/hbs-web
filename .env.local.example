# Supabase — copy to .env.local and fill in from your Supabase project settings
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — only needed for the Site Images CMS (/admin/cms) to bypass
# storage RLS on upload. Project Settings → API → service_role key.
# NEVER expose this to the browser / commit it.
SUPABASE_SERVICE_ROLE_KEY=
